# Nook Forge AI planning baseline.
# Copy this file to .env after the owning stories are implemented.
# The .env file is local runtime configuration and must never be committed.

COMPOSE_PROJECT_NAME=nookforge

# Local ports
WEB_PORT=4200
API_PORT=8080
POSTGRES_PORT=5433
OLLAMA_CONTAINER_PORT=11435

# PostgreSQL and Flyway
POSTGRES_DB=nookforge
POSTGRES_USER=nookforge
POSTGRES_PASSWORD=nookforge-local-only

# Current provider contract: only Ollama is supported in Releases 0.1-0.5.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=120s

# Workspace and archive limits
UPLOAD_MAX_BYTES=26214400
WORKSPACE_MAX_FILES=500
ARCHIVE_MAX_ENTRIES=500
ARCHIVE_MAX_EXTRACTED_BYTES=209715200
ARCHIVE_MAX_ENTRY_BYTES=26214400
ARCHIVE_MAX_PATH_DEPTH=20

# Release 0.5 optional observability defaults.
# Exact self-hosted service settings are added only after the owning story verifies them.
LANGFUSE_ENABLED=false
LANGFUSE_TRACE_CONTENT=false
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=replace-after-release-0.5
LANGFUSE_SECRET_KEY=replace-after-release-0.5
