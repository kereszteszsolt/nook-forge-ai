# Nook Forge AI local runtime defaults.
# Copy this file to .env before starting either supported Compose mode.
# The .env file is local runtime configuration and must never be committed.

COMPOSE_PROJECT_NAME=nookforge

# Local bind address and host ports
BIND_ADDRESS=127.0.0.1
WEB_PORT=4200
API_PORT=8080
POSTGRES_PORT=5433
OLLAMA_CONTAINER_PORT=11435

# PostgreSQL and Flyway
POSTGRES_DB=nookforge
POSTGRES_USER=nookforge
POSTGRES_PASSWORD=nookforge-local-only

# Current provider contract: only Ollama is supported in Releases 0.1-0.5.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=120s

# Reserved disabled defaults for the optional Release 0.5 observability stories.
LANGFUSE_ENABLED=false
LANGFUSE_TRACE_CONTENT=false
LANGFUSE_BASE_URL=
