{
  "name": "@nookforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "build": "npm run generate:check && ng build --configuration production",
    "generate": "npm run tokens:generate && npm run brand:generate",
    "generate:check": "npm run tokens:check && npm run brand:check",
    "tokens:generate": "node ../../packages/design-tokens/scripts/generate-css.mjs",
    "tokens:check": "node ../../packages/design-tokens/scripts/generate-css.mjs --check",
    "brand:generate": "node scripts/generate-brand.mjs",
    "brand:check": "node scripts/generate-brand.mjs --check"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.2.0",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
